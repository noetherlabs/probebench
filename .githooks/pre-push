#!/bin/sh
set -eu

if [ -x .venv/bin/python ]; then
    repository_python=.venv/bin/python
else
    repository_python=python3
fi
if ! command -v gitleaks >/dev/null 2>&1; then
    echo 'Push refused: install Gitleaks to run the credential scan.' >&2
    exit 1
fi

while read -r local_ref local_oid remote_ref remote_oid; do
    case "$local_oid" in
        0000000000000000000000000000000000000000) continue ;;
    esac
    "$repository_python" scripts/check_repository.py --ref "$local_oid"
    # Use the destination's advertised tip. Other remotes do not establish what
    # has already been published to this destination. A new ref needs all history.
    case "$remote_oid" in
        0000000000000000000000000000000000000000) revisions="$local_oid" ;;
        *)
            git cat-file -e "$remote_oid^{commit}"
            revisions="$remote_oid..$local_oid"
            ;;
    esac
    outgoing=$(git rev-list "$revisions")
    for revision in $outgoing; do
        "$repository_python" scripts/check_repository.py --ref "$revision"
        commit_message=$(git log -1 --format=%B "$revision")
        printf '%s\n' "$commit_message" | gitleaks stdin --redact --no-banner
    done
    gitleaks git . --redact --no-banner --log-opts="$revisions"
done
