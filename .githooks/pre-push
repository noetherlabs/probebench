#!/bin/sh
set -eu

if [ -x .venv/bin/python ]; then
    repository_python=.venv/bin/python
else
    repository_python=python3
fi
if ! command -v gitleaks >/dev/null 2>&1; then
    echo 'Push refused: install Gitleaks to run the credential scan.' >&2
    exit 1
fi

while read -r local_ref local_oid remote_ref remote_oid; do
    case "$local_oid" in
        0000000000000000000000000000000000000000) continue ;;
    esac
    "$repository_python" scripts/check_repository.py --ref "$local_oid"
    for revision in $(git rev-list "$local_oid" --not --remotes); do
        "$repository_python" scripts/check_repository.py --ref "$revision"
    done
    gitleaks git . --redact --no-banner --log-opts="$local_oid --not --remotes"
done
